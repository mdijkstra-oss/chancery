      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "insert_content",
      "description": "Inserts markdown content at a position in the document.",
      "parameters": {
        "type": "object",
        "properties": {
          "document_id": {"type": "string", "description": "Target document"},
          "position": {"type": "string", "description": "Where to insert: 'head' (beginning), 'tail' (end), or a block ID to insert after"},
          "content": {"type": "string", "description": "Markdown content to insert"}
        },
        "required": ["document_id", "position", "content"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "delete_blocks",
      "description": "Deletes blocks from a document.",
      "parameters": {
        "type": "object",
        "properties": {
          "document_id": {"type": "string", "description": "Target document"},
          "block_ids": {"type": "array", "description": "IDs of blocks to delete", "items": {"type": "string"}}
        },
        "required": ["document_id", "block_ids"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "move_blocks",
      "description": "Moves blocks to a new position within the document.",
      "parameters": {
        "type": "object",
        "properties": {
          "document_id": {"type": "string", "description": "Target document"},
          "block_ids": {"type": "array", "description": "IDs of blocks to move", "items": {"type": "string"}},
          "position": {"type": "string", "description": "Where to move: 'head', 'tail', or block ID to move after"}
        },
        "required": ["document_id", "block_ids", "position"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_block",
      "description": "Updates a block's text, type, and/or properties in place. Use this to edit existing content without deleting and reinserting.",
      "parameters": {
        "type": "object",
        "$defs": {
          "inlineContent": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {"type": "string", "enum": ["text", "link"]},
                "text": {"type": "string"},
                "href": {"type": "string"},
                "styles": {
                  "type": "object",
                  "properties": {
                    "bold": {"type": "boolean"},
                    "italic": {"type": "boolean"},
                    "underline": {"type": "boolean"},
                    "strikethrough": {"type": "boolean"},
                    "code": {"type": "boolean"}
                  }
                }
              },
              "required": ["type", "text"]
            }
          }
        },
        "properties": {
          "document_id": {"type": "string", "description": "Target document"},
          "block_id": {"type": "string", "description": "ID of block to update"},
          "type": {"type": "string", "enum": ["paragraph", "heading", "quote", "bulletListItem", "numberedListItem", "checkListItem", "toggleListItem", "codeBlock"], "description": "Change block type (optional)"},
          "props": {"type": "object", "description": "Properties to update (optional) - level, background_color, checked, language"},
          "content": {"$ref": "#/$defs/inlineContent", "description": "New text content (optional) - replaces existing text"}
        },
        "required": ["document_id", "block_id"]
      }
    }
  },
  {
    "type": "function",
