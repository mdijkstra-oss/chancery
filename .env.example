# Copy to .env. One provider key is enough to bring the stack up, and it belongs
# to the dragoman service — the only container that reaches a provider. An alias
# in config/models.yaml whose prefix has no key here fails when it is called,
# naming the variable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Host port chancery is published on. Nothing publishes dragoman. The container
# listens on 8081 whatever this says; that port is set in compose.yaml.
CHANCERY_PORT=8081

# Comma-separated allowed origins. Empty denies every cross-origin request.
CORS_ORIGINS=

LOG_LEVEL=info
ENV=production

# Caller headers to put on every log line for the request. A value over 512
# characters is truncated.
LOG_REQUEST_HEADERS=X-Session-ID,X-Project-ID

# Only for running the binary outside compose; under compose the chancery service
# points at the dragoman service name.
# RESPONSES_BASE_URL=http://localhost:8080

# Optional bearer token on every outbound request, for whatever fronts a shared
# backend. Unnecessary while dragoman publishes no port.
# RESPONSES_AUTH_TOKEN=

# Where compose fetches dragoman to build it. A git URL is a complete build
# context; a local path works too, which is what to use when developing the two
# side by side.
# DRAGOMAN_REPO=https://github.com/mdijkstra-oss/dragoman.git
