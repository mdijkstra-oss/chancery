[
  {
    "type": "function",
    "function": {
      "name": "execute_sql",
      "description": "Execute a read-only SQL query against the local DuckDB database. See the 'schema' field for table definitions. Use json_extract or ::json for JSON columns.",
      "schema": {
        "documents": {
          "columns": {
            "id": {"type": "TEXT", "pk": true, "format": "doc-[uuid]"},
            "name": {"type": "TEXT", "nullable": false},
            "description": {"type": "TEXT"},
            "title": {"type": "TEXT"},
            "time": {"type": "TIMESTAMP"},
            "updated_at": {"type": "TIMESTAMP"},
            "original": {"type": "TEXT"},
            "pinned": {"type": "BOOLEAN"},
            "healthy": {"type": "BOOLEAN"},
            "version": {"type": "INTEGER"}
          }
        },
        "blocks": {
          "columns": {
            "id": {"type": "TEXT", "pk": true, "format": "blk-[uuid]"},
            "document_id": {"type": "TEXT", "nullable": false, "fk": "documents.id"},
            "parent_id": {"type": "TEXT", "fk": "blocks.id"},
            "position": {"type": "INTEGER", "nullable": false},
            "type": {"type": "TEXT", "nullable": false, "enum": ["paragraph", "heading", "quote", "bulletListItem", "numberedListItem", "checkListItem", "toggleListItem", "codeBlock", "image", "video", "audio", "file", "table"]},
            "props": {"type": "JSON"},
            "content": {"type": "JSON"}
          }
        },
        "annotations": {
          "columns": {
            "id": {"type": "TEXT", "pk": true, "format": "ann-[uuid]"},
            "document_id": {"type": "TEXT", "nullable": false, "fk": "documents.id"},
            "text": {"type": "TEXT", "nullable": false},
            "actor": {"type": "TEXT", "nullable": false},
            "color": {"type": "TEXT", "nullable": false},
            "reason": {"type": "TEXT"},
            "code_id": {"type": "TEXT", "format": "code-[uuid]"},
            "confidence": {"type": "TEXT", "enum": ["high", "medium", "low"]}
          }
        }
      },
      "parameters": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "description": "A valid DuckDB SQL SELECT query. Only read operations allowed."
          }
        },
        "required": ["sql"]
      }
    }
  }
]
