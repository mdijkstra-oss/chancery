# Copy to .env.local, which the make targets read. The real values live there
# and nowhere in git.

# Where chancery POSTs. Scheme, host and port; chancery appends /responses.
# Required: serve refuses to boot without it.
RESPONSES_BASE_URL=http://localhost:8080

# Optional bearer token on every outbound request, for whatever fronts the
# backend. A backend that needs no credential leaves this empty.
RESPONSES_AUTH_TOKEN=

# A second credential, for a platform that guards the backend's endpoint rather
# than the backend itself. The header name differs per platform -- X-Auth-Token
# on Scaleway, Authorization on Cloud Run -- so it is named here. Set both or
# neither; one alone is refused at boot.
RESPONSES_GATEWAY_HEADER=
RESPONSES_GATEWAY_TOKEN=

# Port chancery listens on.
PORT=8081

# Comma-separated origins a browser may call from. Empty denies every
# cross-origin request.
CORS_ORIGINS=

LOG_LEVEL=info
ENV=development

# Grace period for in-flight requests on SIGTERM.
SHUTDOWN_TIMEOUT=60s

# Caller headers to put on every log line for the request. A value over 512
# characters is truncated.
LOG_REQUEST_HEADERS=X-Session-ID,X-Project-ID

# JWT validation stays off until one key source is set, and serve says so at
# boot. Setting either makes the three below required.
# AUTH_JWT_JWKS_URL=
# AUTH_JWT_PUBLIC_KEY_FILE=
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=
# AUTH_JWT_ALGORITHMS=
